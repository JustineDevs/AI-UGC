{
  "id": "revise-output",
  "version": "1.0.0",
  "label": "Revise Output",
  "purpose": "Regenerate or refine low-quality prompt drafts from scoring feedback.",
  "required_inputs": ["prompt_text", "revision_recommendations", "workflow_blueprint"],
