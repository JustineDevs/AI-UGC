{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@ai-ugc/contracts": ["../../packages/contracts/src/index.ts"],
      "@ai-ugc/config": ["../../packages/config/src/index.ts"],
      "@ai-ugc/domain": ["../../packages/domain/src/index.ts"],
      "@ai-ugc/provider-core": ["../../packages/provider-core/src/index.ts"],
      "@ai-ugc/provider-laozhang": ["../../packages/provider-laozhang/src/index.ts"],
      "@ai-ugc/provider-apimart": ["../../packages/provider-apimart/src/index.ts"],
      "@ai-ugc/workflow-engine": ["../../packages/workflow-engine/src/index.ts"],
      "@ai-ugc/niche-packs": ["../../packages/niche-packs/src/index.ts"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "../../packages/**/*.ts", "../../tooling/scripts/**/*.ts"]
}
