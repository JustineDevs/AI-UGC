NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ugc_template

GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.5-flash

DEFAULT_PROVIDER=laozhang
