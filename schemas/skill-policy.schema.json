{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-UGC Skill Policy",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "operator", "message"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "operator": {
            "type": "string",
            "enum": [
              "exists",
              "nonEmptyString",
              "object",
              "boolean",
              "equals",
              "equalsField",
              "minimum",
              "oneOf",
              "arrayMin",
              "arrayMax"
            ]
          },
          "value": {},
          "comparePath": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
