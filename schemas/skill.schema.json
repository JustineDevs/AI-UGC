{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-UGC Skill Definition",
  "type": "object",
  "required": ["id", "version", "label", "purpose", "required_inputs", "produces"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "purpose": { "type": "string" },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "produces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_prompt_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_providers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retry_policy": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
